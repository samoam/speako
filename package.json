{
  "name": "speako",
  "version": "0.1.0",
  "description": "Phase 1: live audio capture and real-time speaker-separated transcription",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "node dist/index.js start",
    "dev": "ts-node src/index.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register -r ./tests/setEnv.js --test tests/streamManager.test.ts"
  },
  "dependencies": {
    "@google-cloud/language": "^7.2.3",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
