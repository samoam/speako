# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# GCP project id (must match the service account's project)
GCP_PROJECT_ID=your-gcp-project-id

# Region for the Speech-to-Text v2 recognizer. chirp_3 is available in "us" and "eu"
# multi-region locations only (not zonal regions like us-central1).
GCP_SPEECH_LOCATION=us

# Speech model. chirp_3 is used for transcription quality; diarization is NOT
# available in streaming mode for any current model (see NOTES.md), so speaker
# separation is done via multi-channel audio (mic vs. system) instead.
SPEECH_MODEL=chirp_3

# BCP-47 language codes to recognize, comma separated. "auto" lets chirp_3
# detect the dominant spoken language per session (e.g. French or English)
# instead of pinning to one; or set an explicit code like fr-FR or en-US.
SPEECH_LANGUAGE_CODES=auto

# Audio capture device names, as seen by the legacy Windows MME API that SoX's
# waveaudio driver uses on Windows — these are NOT the friendly names shown in
# Settings > Sound, and are truncated to 31 characters (a Windows MME limit).
# `sox -t waveaudio -d` won't list them either. See README.md's device-name
# discovery section for a winmm.dll probe that lists the exact names SoX needs.
MIC_AUDIO_DEVICE=Microphone Array
SYSTEM_AUDIO_DEVICE=CABLE Output (VB-Audio Virtual Cable)

# Path to the sox executable. Leave as "sox" if it's on your PATH, or point
# this at a local copy, e.g. ./tools/sox-14.4.2/sox.exe
SOX_BINARY=sox

# Sample rate for capture and recognition (Hz)
SAMPLE_RATE=16000

# Seconds of continuous streaming before proactively restarting the stream
# to avoid hitting undocumented/variable server-side limits. Tune based on
# observed stability.
STREAM_RESTART_SECONDS=240

# Local SQLite file
DB_PATH=./data/speako.db

# Local web interface port
HTTP_PORT=3000

# GCS bucket for post-session diarization. After a session is stopped, its
# audio is uploaded here and run through BatchRecognize with diarization
# enabled to replace the live channel-based "You"/"Others" labels with real
# per-speaker labels (Speaker 1, Speaker 2, ...) once processing finishes.
# Diarization is skipped entirely if this is left blank. See README.md for
# how to create the bucket and grant the service account access to it.
GCS_BUCKET=
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=6

# Gemini API key for on-demand meeting summarization and action-item extraction
# ("Generate summary" button). Get a key from https://aistudio.google.com/apikey.
# Feature is skipped entirely if this is left blank.
GEMINI_API_KEY=
# "gemini-flash-latest" is an alias that stays current automatically — Google
# deprecates pinned model names surprisingly fast (confirmed during development:
# gemini-2.5-flash was already unavailable to new API keys). Prefer the alias
# unless you have a specific reason to pin an exact version.
GEMINI_MODEL=gemini-flash-latest

# --- Phase 3: speech adaptation, sentiment, trigger detection, RAG, suggestions ---
# Unlike diarization/summarization above, everything in this section runs
# AUTOMATICALLY during recording — each operates only on text already
# stored/shown live, and is required for the live suggestion pipeline to work
# at all (an on-demand version wouldn't be "live"). Each has its own toggle
# below if you'd rather disable it.

# Versioned domain-vocabulary list biasing streaming recognition (project
# names, tools, acronyms). Edit config/phrase-hints.json to add your own terms.
PHRASE_HINTS_PATH=./config/phrase-hints.json

# Sentiment scoring (Cloud Natural Language API) on each finalized live segment.
SENTIMENT_ENABLED=true

# Trigger detection: flags factual claims, decision points, vague commitments
# (Gemini classifier), tone shifts (sentiment delta), and unanswered questions
# (timer). Tune thresholds if you get too much/too little noise.
TRIGGER_DETECTION_ENABLED=true
TRIGGER_CONFIDENCE_THRESHOLD=0.6
TRIGGER_COOLDOWN_MS=45000
TRIGGER_RATE_LIMIT_PER_MINUTE=4
UNANSWERED_QUESTION_TIMEOUT_MS=20000
TONE_SHIFT_DELTA=0.5

# RAG: every stopped session's transcript is embedded (Gemini) into a corpus
# searched to ground suggestions in your own past meetings. Brute-force cosine
# similarity in SQLite — no separate vector DB needed at personal scale.
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.65

# --- Phase 4: multi-source fact-check / live Q&A (Bitbucket Server, Jira, Confluence) ---
# Each source is independently optional — the feature is skipped for any
# source whose variables are left blank. See NOTES.md's "Phase 4" section for
# what was actually verified/discovered about each of these during development.

# Bitbucket Server / Data Center (self-hosted — NOT Bitbucket Cloud, a
# completely different API). Username + HTTP access token, Basic auth.
# No server-wide code search is available (confirmed broken both via REST and
# the web UI on this instance), so scope it to specific repos instead:
# comma-separated "PROJECT_KEY/repo-slug" pairs. Within those repos, claims/
# questions are checked against recent commit messages (keyword overlap) and,
# if a file path is directly named, that file's raw content.
BITBUCKET_SERVER_URL=
BITBUCKET_SERVER_USERNAME=
BITBUCKET_SERVER_TOKEN=
BITBUCKET_SERVER_REPOS=

# Jira — queried via the read-only mcp-atlassian MCP server (spawned locally
# via `uvx mcp-atlassian`, not called over REST directly). Personal access
# token, not a password.
JIRA_URL=
JIRA_PERSONAL_TOKEN=

# Confluence — same mcp-atlassian MCP server, different tool (confluence_search).
# CONFLUENCE_API_TOKEN should be a scoped API token, not your account password.
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Live in-meeting Q&A (typed question box). On-demand, like diarization/
# summarization — an explicit user action rather than something automatic.
LIVE_QA_ENABLED=true

# --- Improvements Phase §2: persistent meeting-state layer ---
# Rolling summary + open-items registry, updated incrementally every N
# finalized segments (not per-segment, to avoid an extra live-latency
# bottleneck). Runs automatically during recording, like sentiment/triggers/
# RAG above — suggestion quality/fact-check accuracy depends on it being
# current. See NOTES.md for how this plugs into triggers/fact-check/Q&A.
MEETING_STATE_ENABLED=true
MEETING_STATE_UPDATE_EVERY_SEGMENTS=6

# --- Improvement: live audio waveform indicator ---
# Purely cosmetic scrolling oscillogram, top of the session view, confirming
# capture is actually active. Server-side downsampled (see NOTES.md — the
# source doc assumed a browser-side MediaStreamSource, which doesn't apply
# to this app's server-side SoX capture) and broadcast over the existing
# WebSocket. Automatic during recording, like sentiment/triggers.
WAVEFORM_ENABLED=true

# --- Speako 2.0: pre-meeting prep ---
# Work sessions (as opposed to Personal, the default/unchanged one-click
# flow) get a prep stage before recording: pick a meeting type (standup,
# sprint planning/review, retro, one-on-one, design/dev discussion, or
# generic), and a type-specific workflow gathers Jira/Confluence/Bitbucket
# context (+ mem0/MyRAG below where applicable), synthesizes it into a brief
# via Gemini, and seeds it into meeting_state so live triggers/suggestions
# are grounded from segment one instead of starting cold. See NOTES.md.
PREP_ENABLED=true

# mem0-cloud: durable cross-meeting facts (a remote MCP server, not a local
# subprocess like Jira/Confluence above) — read during one-on-one prep,
# written after a summary is generated. Feature is skipped if unset.
MEM0_MCP_URL=
MEM0_MCP_API_KEY=

# rag-cloud (MyRAG): external reference ingestion (design docs, repos) for
# design/dev-discussion prep. Same remote MCP shape as mem0-cloud. Feature
# is skipped if unset.
RAG_MCP_URL=
RAG_MCP_API_KEY=

# Google Calendar (optional, purely additive) — auto-detects meeting type
# from upcoming events and powers the "prep this meeting" shortcuts in the
# UI. Without it, Work sessions still work fine via manual meeting-type
# selection. One-time setup: download an OAuth "Desktop app" client secret
# JSON from the Google Cloud Console (APIs & Services > Credentials), point
# GOOGLE_CALENDAR_CREDENTIALS_PATH at it, then run `npm run gcal-auth` once.
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_TOKEN_PATH=./data/gcal-token.json
PREP_WINDOW_MINUTES=15

# Local codebase indexing for design/dev-discussion prep (src/codebase/) —
# chunks + Gemini-embeds source files already checked out on this machine
# into a local SQLite table, same pattern as the past-meeting RAG corpus.
# Deliberately local-only: no remote cloning, no credentials, source code
# never leaves this machine except for the text sent to Gemini for embedding.
# Comma-separated "name=path" pairs. Feature is skipped if unset.
CODEBASE_LOCAL_PATHS=

# Outlook mail ingestion — via the `claude` CLI's Microsoft 365 connector
# (src/integrations/claudeConnectorCli.ts). Auth is a one-time `claude mcp
# login` done outside Speako entirely; there's no client ID/tenant/token-path
# config here. How often the background sync runs, and how far back each run
# looks (deliberate overlap so a missed run can't create a gap — re-syncing
# an already-seen message is harmless).
EMAIL_SYNC_POLL_MINUTES=15
EMAIL_SYNC_LOOKBACK_HOURS=48

# Teams chat ingestion — same Microsoft 365 connector as email above, just a
# different tool (chat_message_search vs. outlook_email_search). No separate
# setup needed.
TEAMS_SYNC_POLL_MINUTES=15
TEAMS_SYNC_LOOKBACK_HOURS=48
